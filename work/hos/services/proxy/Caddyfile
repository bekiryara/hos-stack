# Reverse proxy (optional) for prod-like HTTPS testing on localhost.
# Used by: work/hos/docker-compose.proxy.yml

api.localhost {
  reverse_proxy api:3000
}

grafana.localhost {
  reverse_proxy grafana:3000
}

prometheus.localhost {
  reverse_proxy prometheus:9090
}

alertmanager.localhost {
  reverse_proxy alertmanager:9093
}

tempo.localhost {
  reverse_proxy tempo:3200
}
