# Git attributes for line ending normalization
# WP-NEXT: repo eol policy — default auto; web sources LF; Windows scripts CRLF

* text=auto

# Web / source: LF
*.vue text eol=lf
*.js  text eol=lf
*.ts  text eol=lf
*.tsx text eol=lf
*.css text eol=lf
*.json text eol=lf
*.md  text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Windows scripts: CRLF
*.ps1 text eol=crlf

# Shell scripts: LF
*.sh text eol=lf

# PHP: LF
*.php text eol=lf

# Dockerfile: LF
Dockerfile text eol=lf
*.Dockerfile text eol=lf

# Config files: LF
*.conf text eol=lf
*.config text eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
